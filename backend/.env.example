PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
LLM_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_KEEP_ALIVE=10m
LLM_NUM_PREDICT=96
LLM_NUM_CTX=4096
LLM_THINK=false
# Leave URLs blank to use direct local models.
# If STT hangs on the second transcription (works once, then never returns), your GPU's
# CUDA generation likely isn't fully supported yet by ctranslate2 (faster-whisper's backend)
# — seen on RTX 50-series/Blackwell. Plain PyTorch CUDA ops still work fine; this is specific
# to ctranslate2. Workaround: STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8 (slower, correct).
STT_URL=
STT_API_KEY=
STT_MODE=local
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
TTS_URL=
TTS_ENABLED=false
TTS_API_KEY=
TTS_MODE=local
TTS_ENGINE=xtts_v2
TTS_GPU=true
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_MODEL_PATH=D:\ai_local_model\models\piper\en_US-lessac-medium.onnx
TTS_MODEL_PATHS={}
# Named voice profiles for XTTS v2 cloning: voice name -> reference WAV (6-15s, clean audio).
# Replaces a single global TTS_SPEAKER_WAV so "default" and "cloned" (or any name you choose)
# are real, distinct voices instead of a no-op dropdown. TTS_SPEAKER_WAV alone still works as
# a "default" profile if you only need one voice.
TTS_VOICE_PROFILES={"default":"D:\\ai_local_model\\models\\voices\\reference.wav"}
TTS_SPEAKER_WAV=

# SQLite persistence for calls, campaigns, and uploaded documents.
DATABASE_URL=sqlite:///D:\ai_local_model\backend\data\aura.db
# Local multilingual embedding model for semantic document search (covers English,
# Hindi, Telugu, Tamil, Kannada, Spanish). Downloads on first use.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Live Call WebSocket pipeline: end-of-speech detection tuning.
# 700ms measured too tight -- an ordinary 960ms pause between two words in a real
# speech sample triggered a premature end-of-turn, splitting one sentence into two
# incomplete questions sent to the LLM. 1100ms gives real pauses more headroom.
VAD_SILENCE_MS=1100
VAD_MIN_SPEECH_MS=250
LIVE_SAMPLE_RATE=16000

# Local IndicTrans2 ONNX model (English -> Hindi/Telugu/Tamil/Kannada/Malayalam/Bengali/
# Marathi/Gujarati/Punjabi/Urdu). The LLM cannot write these languages reliably on its
# own (verified: garbled/script-mixed output), so replies are generated in English and
# translated by this dedicated model instead. Download once from either:
#   https://huggingface.co/naklitechie/indictrans2-en-indic-dist-200M-ONNX (fp32, ~1.3GB, used here)
#   https://huggingface.co/remiai3/TRANSLATION_MODELS (int8, ~335MB, lower quality -- flagged
#   by its own README as a research artifact, not for production)
# Leave blank to disable: those languages then fall back to asking the LLM to answer
# directly (the old, less reliable behavior for that language only).
INDIC_TRANSLATION_MODEL_PATH=D:\ai_local_model\backend\data\models\indictrans2-en-indic-dist-200M-ONNX-fp32
# Reverse direction: translates an Indic-language question to English before document
# retrieval and generation (cross-lingual embedding similarity was measured far weaker
# than same-language matching -- without this, correct answers in the document go
# unfound for non-English questions). Download from either:
#   https://huggingface.co/remiai3/TRANSLATION_MODELS (int8, ~215MB, used here --
#   acceptable for this internal retrieval-quality step, unlike the user-facing
#   INDIC_TRANSLATION_MODEL_PATH above where fp32 was used instead)
INDIC_TRANSLATION_REVERSE_MODEL_PATH=D:\ai_local_model\backend\data\models\indictrans2-indic-en-dist-200M-ONNX-int8
